<mxfile host="DeckWerk">
  <diagram name="Math" id="math">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="loss" value="Loss $$\mathcal{L} = \sum_i (y_i - \hat{y}_i)^2$$" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="240" height="120" as="geometry" />
        </mxCell>
        <mxCell id="value" value="Value \(V(s)\) of a state" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="edge" value="\(\pi_\theta(a \mid s)\)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=16;" edge="1" parent="1" source="loss" target="value">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="frac" value="$$\frac{\partial \mathcal{L}}{\partial \theta}$$" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="160" height="90" as="geometry" />
        </mxCell>
        <mxCell id="env" value="\begin{aligned} a &amp;= b + c \\ d &amp;= e \end{aligned}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="240" y="200" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="mixed" value="&lt;b&gt;Policy&lt;/b&gt;&lt;br&gt;\(\pi(a|s) = \sigma(z)\)&lt;br&gt;costs \$5" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="440" y="200" width="160" height="100" as="geometry" />
        </mxCell>
        <mxCell id="plain" value="plain $$x^2$$ stays" style="rounded=0;fillColor=#f5f5f5;strokeColor=#666666;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="160" height="40" as="geometry" />
        </mxCell>
        <mxCell id="sqrt" value="$$\sqrt{x^2 + y^2} \leq \alpha \beta$$" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="240" y="330" width="200" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
