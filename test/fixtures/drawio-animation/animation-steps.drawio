<mxfile host="drawio">
  <diagram id="anim" name="Animated">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <UserObject label="" animation="{&quot;animation&quot;:{&quot;steps&quot;:[{&quot;opacity&quot;:{&quot;cells&quot;:[&quot;*&quot;],&quot;value&quot;:0}},{&quot;fadeIn&quot;:{&quot;cells&quot;:[&quot;enc&quot;],&quot;delay&quot;:400}},{&quot;wait&quot;:800},{&quot;wipeIn&quot;:{&quot;cells&quot;:[&quot;e1&quot;]}},{&quot;popIn&quot;:{&quot;cells&quot;:[&quot;z&quot;],&quot;delay&quot;:600},&quot;immediate&quot;:true},{&quot;wait&quot;:500},{&quot;wipeIn&quot;:{&quot;cells&quot;:[&quot;e2&quot;],&quot;delay&quot;:700}},{&quot;fadeIn&quot;:{&quot;cells&quot;:[&quot;dec&quot;]}},{&quot;flow&quot;:{&quot;cells&quot;:[&quot;e2&quot;],&quot;start&quot;:true},&quot;immediate&quot;:true},{&quot;wait&quot;:1000},{&quot;fadeTo&quot;:{&quot;cells&quot;:[&quot;enc&quot;],&quot;value&quot;:0.3,&quot;delay&quot;:500}},{&quot;highlight&quot;:{&quot;cells&quot;:[&quot;dec&quot;],&quot;color&quot;:&quot;#ff0000&quot;,&quot;duration&quot;:800}},{&quot;viewbox&quot;:{&quot;x&quot;:0,&quot;y&quot;:0,&quot;width&quot;:400,&quot;height&quot;:200,&quot;smooth&quot;:true}}],&quot;loop&quot;:false}}" id="0">
          <mxCell />
        </UserObject>
        <mxCell id="1" parent="0" />
        <mxCell id="enc" value="Encoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="z" value="z" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="230" y="85" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="dec" value="Decoder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="350" y="80" width="120" height="60" as="geometry" />
        </mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="enc" target="z">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="decode" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="z" target="dec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="endArrow=classic;html=1;flowAnimation=1;" edge="1" parent="1" source="enc" target="dec">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="255" y="200" /></Array></mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
